# ---- apps/api (Railway service variables; never commit real values) ----
ENVIRONMENT=development            # production on Railway
LOG_LEVEL=INFO
DATABASE_URL=postgresql://user:pass@host:5432/trail   # Railway: reference ${{Postgres.DATABASE_URL}} (private network)
JWT_SECRET_KEY=                    # 32+ random bytes, e.g. `openssl rand -hex 32`; required in production
LLM_PROVIDER=mock                  # mock | anthropic
LLM_API_KEY=                       # only when LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000   # comma-separated exact origins (the Vercel domain(s))

# ---- apps/web (Vercel project variables) ----
# Server-side only, needed AT BUILD TIME because Next.js bakes rewrites into the build:
API_URL=http://localhost:8000
# Optional, non-sensitive:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
